# PostgreSQL connection string (Neon / Vercel Postgres / Supabase / local)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# Long random string used to sign login sessions
AUTH_SECRET=change-me-to-a-long-random-string

# First super admin (created by `npm run db:seed`)
ADMIN_NAME=Temple Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Photo uploads on Vercel: create a Blob store in the Vercel dashboard (auto-adds this)
BLOB_READ_WRITE_TOKEN=
